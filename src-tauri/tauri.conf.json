{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tina",
  "version": "0.1.0",
  "identifier": "com.tina.local",
  "build": {
    "beforeDevCommand": "npm run dev --prefix src-frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix src-frontend",
    "frontendDist": "../src-frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tina - Inteligência Pessoal",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
